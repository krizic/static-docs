{
  "$schema": "./schema.json",
  "siteName": "StaticDocs",
  "outputDir": "./docs-build",
  "basePath": "/",
  "theme": "default",
  "sidebar": {
    "auto": true,
    "collapsedDepth": 1,
    "exclude": ["docs/superpowers/**"]
  },
  "toc": { "enabled": true, "minDepth": 2, "maxDepth": 4 },
  "markdown": { "gfm": true, "smartypants": true }
}
